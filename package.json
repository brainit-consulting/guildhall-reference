{
  "name": "guildhall-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/migrate.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/migrate.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=default",
    "test:unit": "vitest run --project unit --reporter=default",
    "test:integration": "vitest run --project integration --reporter=default",
    "test:e2e": "playwright test && node scripts/check-e2e-data.mjs",
    "e2e:server": "node scripts/clean-e2e-data.mjs && npm run dev",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@neondatabase/serverless": "1.1.0",
    "better-auth": "1.7.5",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.16.0",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "2.6.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.7",
    "dotenv": "16.6.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "postcss": "8.5.23",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3",
    "vitest": "4.1.7"
  }
}
